# 复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，不会提交到仓库。
# 启动优先级（已存在的变量不被覆盖，项目配置优先于用户全局配置）：
#   1) 当前项目根目录的 .env
#   2) 用户主目录下的 .hello/.env   （推荐：放一份全局默认配置，任何项目里直接 hello 即用）
#   3) 用户主目录下的 .env

# OpenAI 接口风格服务商的密钥（OpenAI / DeepSeek / 通义千问 / Moonshot / 本地模型 等）
OPENAI_API_KEY=

# 可选：OpenAI 兼容端点，缺省为 https://api.openai.com/v1
# 例：
#   DeepSeek     https://api.deepseek.com/v1
#   通义千问     https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot     https://api.moonshot.cn/v1
#   Ollama       http://localhost:11434/v1
# OPENAI_BASE_URL=

# 可选：模型名，缺省为 gpt-4o-mini
# 例：deepseek-chat / qwen-plus / qwen2.5-coder:7b
# OPENAI_MODEL=
