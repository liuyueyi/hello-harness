/* ==========================================================================
   Hello Harness · 主题样式
   设计基调：陶土橙 (#d95c41) + 暖米白，干净、可读、克制。
   ========================================================================== */

:root {
  /* 品牌色 */
  --hh-primary: #d95c41;
  --hh-primary-dark: #b8462f;
  --hh-primary-soft: rgba(217, 92, 65, 0.12);
  --hh-bg-soft: #faf8f4;
  --hh-border: #e7e1d6;
  --hh-card-shadow: 0 1px 2px rgba(26, 26, 26, 0.04), 0 10px 28px rgba(26, 26, 26, 0.06);
  --hh-radius: 14px;

  /* 注入 VitePress 主题变量，让原生组件（链接/按钮/侧边栏激活项）统一品牌色 */
  --vp-c-brand-1: #d95c41;
  --vp-c-brand-2: #cf5238;
  --vp-c-brand-3: #b8462f;
  --vp-c-brand-soft: var(--hh-primary-soft);
}

.dark {
  --hh-primary: #e8765c;
  --hh-primary-dark: #d95c41;
  --hh-primary-soft: rgba(232, 118, 92, 0.16);
  --hh-bg-soft: #1b1916;
  --hh-border: #34302a;
  --hh-card-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 10px 28px rgba(0, 0, 0, 0.4);

  --vp-c-brand-1: #e8765c;
  --vp-c-brand-2: #d95c41;
  --vp-c-brand-3: #cf5238;
  --vp-c-brand-soft: rgba(232, 118, 92, 0.16);
}

/* ---------- 基础排版 ---------- */
.vp-doc {
  font-size: 16px;
}

.vp-doc h1,
.vp-doc h2,
.vp-doc h3 {
  font-weight: 700;
  letter-spacing: -0.01em;
}

.vp-doc h2 {
  border-top: none;
  padding-top: 1.6rem;
  margin-top: 2.4rem;
}

/* 链接：品牌色 + 悬停下划线 */
.vp-doc a:not(.card):not(.VPLink) {
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.vp-doc a:not(.card):hover {
  border-bottom-color: var(--vp-c-brand-1);
}

/* ---------- 引用块 ---------- */
.vp-doc blockquote {
  border-left: 3px solid var(--vp-c-brand-1);
  background: var(--hh-primary-soft);
  border-radius: 0 10px 10px 0;
  padding: 10px 18px;
  color: var(--vp-c-text-1);
}
.vp-doc blockquote > p {
  margin: 6px 0;
}

/* ---------- 行内代码 ---------- */
.vp-doc :not(pre) > code {
  background: var(--hh-primary-soft);
  color: var(--hh-primary-dark);
  border-radius: 6px;
  padding: 2px 6px;
  font-size: 0.86em;
  font-weight: 600;
}
.dark .vp-doc :not(pre) > code {
  color: var(--hh-primary);
}

/* ---------- 代码块 ---------- */
.vp-doc div[class*="language-"] {
  border: 1px solid var(--hh-border);
  border-radius: 12px;
  box-shadow: var(--hh-card-shadow);
}

/* ---------- 表格 ---------- */
.vp-doc table {
  display: table;
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  overflow: hidden;
  border: 1px solid var(--hh-border);
  border-radius: 12px;
  font-size: 0.95em;
}
.vp-doc th,
.vp-doc td {
  border-bottom: 1px solid var(--hh-border);
  border-right: 1px solid var(--hh-border);
  padding: 9px 14px;
  transition: background 0.15s ease;
}
.vp-doc th:last-child,
.vp-doc td:last-child {
  border-right: none;
}
.vp-doc tr:last-child td {
  border-bottom: none;
}
.vp-doc thead th {
  background: var(--hh-primary-soft);
  color: var(--vp-c-text-1);
  font-weight: 700;
  text-align: left;
}
.vp-doc tbody tr:nth-child(even) {
  background: var(--hh-bg-soft);
}
.dark .vp-doc tbody tr:nth-child(even) {
  background: rgba(255, 255, 255, 0.02);
}
.vp-doc tbody tr:hover td {
  background: var(--hh-primary-soft);
}

/* ---------- 首页 Hero（VitePress home layout） ---------- */
.VPHero .title {
  background: linear-gradient(120deg, var(--hh-primary), #e8a23c);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-weight: 800;
}
.VPHero .tagline {
  max-width: 620px;
  margin: 0 auto;
  line-height: 1.6;
}
.VPHero .actions .VPButton.brand {
  background: var(--hh-primary);
  border-color: var(--hh-primary);
  box-shadow: 0 6px 18px rgba(217, 92, 65, 0.28);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.VPHero .actions .VPButton.brand:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(217, 92, 65, 0.36);
}

/* ---------- 首页 Feature 卡片 ---------- */
.VPFeatures .item .box {
  border: 1px solid var(--hh-border);
  border-radius: var(--hh-radius);
  background: var(--vp-c-bg);
  box-shadow: var(--hh-card-shadow);
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.VPFeatures .item .box:hover {
  transform: translateY(-4px);
  border-color: var(--vp-c-brand-1);
}
.VPFeatures .item .icon {
  color: var(--vp-c-brand-1);
  font-size: 28px;
}

/* ---------- 自定义卡片（card-grid / card） ---------- */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 18px;
  margin: 28px 0;
}

.card {
  display: block;
  padding: 22px 24px;
  border: 1px solid var(--hh-border);
  border-radius: var(--hh-radius);
  background: var(--hh-bg-soft);
  color: var(--vp-c-text-1);
  text-decoration: none;
  box-shadow: var(--hh-card-shadow);
  transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
}
.card:hover {
  transform: translateY(-4px);
  border-color: var(--vp-c-brand-1);
  text-decoration: none;
}
.card h3 {
  margin: 0 0 8px;
  font-size: 17px;
  color: var(--vp-c-text-1);
}
.card p {
  margin: 0;
  font-size: 14px;
  line-height: 1.65;
  color: var(--vp-c-text-2);
}

.index-list {
  padding-left: 1.2em;
  line-height: 2;
}
.index-list li {
  margin: 4px 0;
}

/* ---------- 徽章 ---------- */
.stage-badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
  color: var(--hh-primary);
  background: var(--hh-primary-soft);
}

.tag-badge {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 6px;
  font-family: var(--vp-font-family-mono);
  font-size: 13px;
  color: var(--vp-c-text-2);
  background: var(--vp-c-bg-alt);
  border: 1px solid var(--hh-border);
}

/* 状态徽章：用于概览表格 */
.badge-done {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: #2f7d4f;
  background: rgba(47, 125, 79, 0.12);
}
.badge-planned {
  display: inline-block;
  padding: 2px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  color: #8a8276;
  background: rgba(138, 130, 118, 0.16);
}
.dark .badge-done {
  color: #6fd49a;
  background: rgba(111, 212, 154, 0.14);
}
.dark .badge-planned {
  color: #b8b0a3;
  background: rgba(184, 176, 163, 0.16);
}

/* ---------- 章节表（chapter-table） ---------- */
table.chapter-table {
  font-size: 14px;
}
.chapter-table td {
  vertical-align: top;
}

/* ---------- 自定义提示块（custom-block / admonition） ---------- */
.vp-doc .custom-block {
  border-radius: 10px;
  border-left-width: 4px;
}
.vp-doc .custom-block .custom-block-title {
  font-weight: 700;
}

/* ---------- 选区与滚动 ---------- */
::selection {
  background: var(--hh-primary-soft);
}
