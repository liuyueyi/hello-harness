{
  "name": "hello-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从 0 到 1 构建现代 Coding Agent Harness 的教学项目：从 Agent Loop 到 Self-Improving Harness。",
  "license": "MIT",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env src/index.ts",
    "dev:watch": "node --import tsx --watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "mermaid": "^11.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "openai": "^7.4.0"
  }
}